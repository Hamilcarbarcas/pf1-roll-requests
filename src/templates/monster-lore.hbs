<div class="pf1-monster-lore-form">
    <div class="ml-monster-section">
        {{#if hasReference}}
        <div class="ml-monster-display">
            <img src="{{monsterImg}}" class="ml-monster-portrait" />
            <div class="ml-monster-info">
                <span class="ml-monster-name">{{monsterName}}</span>
                <div class="ml-monster-stats">
                    <span title="{{localize "RR.ML.CRTitle"}}"><strong>{{localize "RR.ML.CR"}}</strong> {{crLabel}}</span>
                    <span title="{{localize "RR.ML.TypeTitle"}}"><strong>{{localize "RR.ML.TypeShort"}}</strong> {{typeLabel}}</span>
                </div>
            </div>
            <div class="ml-monster-actions">
                <button type="button" data-action="syncMonster" title="{{localize "RR.ML.ResyncTitle"}}"><i class="fas fa-sync-alt"></i></button>
                <button type="button" data-action="clearMonster" title="{{localize "RR.ML.ClearTitle"}}"><i class="fas fa-times"></i></button>
            </div>
        </div>
        {{else}}
        <div class="ml-monster-drop-zone" data-action="grabToken">
            <i class="fas fa-bullseye"></i>
            <span>{{localize "RR.ML.DropZone"}}</span>
        </div>
        {{/if}}
    </div>

    <div class="form-group">
        <label for="ml-type">{{localize "RR.ML.MonsterType"}}</label>
        <select id="ml-type" name="type">
            {{#each types}}
            <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label for="ml-cr">{{localize "RR.ML.ChallengeRating"}}</label>
        <select id="ml-cr" name="cr">
            {{#each crOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize "RR.ML.CR"}} {{this.label}}</option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label for="ml-rarity">{{localize "RR.ML.Rarity"}}</label>
        <select id="ml-rarity" name="rarity">
            {{#each rarities}}
            <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </div>

    <hr />

    <div class="ml-derived">
        <div class="ml-derived-row"><span>{{localize "RR.ML.KnowledgeSkill"}}</span><strong>{{skillName}}</strong></div>
        <div class="ml-derived-row"><span>{{localize "RR.ML.CheckDC"}}</span><strong>{{dc}}</strong></div>
    </div>

    <div class="ml-actions">
        <button type="button" data-action="requestChecks">
            <i class="fas fa-dice-d20"></i> {{localize "RR.ML.RequestChecks"}}
        </button>
    </div>
</div>
